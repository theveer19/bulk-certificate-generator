# Copy to .env and adjust. Every value has a working default, so the service
# runs without a .env file at all.

# --- Database --------------------------------------------------------------
# Default: a local SQLite file (no setup required).
# DATABASE_URL=sqlite:///./certificates.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://certificates:certificates@localhost:5432/certificates

# --- Storage ---------------------------------------------------------------
# Directory that generated PDFs are written to.
# STORAGE_DIR=./storage/certificates

# --- Limits ----------------------------------------------------------------
# Largest number of recipients accepted in a single job.
# MAX_RECIPIENTS_PER_JOB=1000

# --- Certificate content ---------------------------------------------------
ORGANIZATION_NAME=OneT Digital Solutions
SIGNATORY_NAME=Veer Gurjar
SIGNATORY_TITLE=Director

# --- Fonts (optional) ------------------------------------------------------
# The built-in fonts cover Latin-1. To print names in other scripts
# (Devanagari, for example), point this at a TrueType font that supports them.
# CERTIFICATE_FONT_PATH=/path/to/NotoSansDevanagari-Regular.ttf

# --- Misc ------------------------------------------------------------------
# DEBUG=false
